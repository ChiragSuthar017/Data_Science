from flask import Flask , render_template , request

app = Flask(__name__)

@app.route("/" ,methods=["GET" , "POST"])
def hello_world():
    if request.method == "POST":
        name  = request.form["name"]
        email = request.form["email"]
        password = request.form["password"]
        print(f"The name is {name} the emial is {email} and the password is {password}")
        return "<b> Thanks for using my flask. you are now logged in </b>" 
    return render_template ("03_form_in_flask.html")

app.run(debug=True)